# Secrets / local env
.env
server/.env

# Python virtual environment (match dirs AND the collector/.venv symlink:
# no trailing slash so a symlink named .venv is ignored too)
.venv
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE files
.idea/
.vscode/

# Log files
logs/
*.log

# Captured telemetry data (local SQLite store, WAL/SHM, offload exports)
data/
*.db
*.db-wal
*.db-shm

# Build outputs
dist/
build/
*.spec

# OS files
.DS_Store
Thumbs.db