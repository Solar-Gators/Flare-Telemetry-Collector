# Copy to server/.env and fill in. Do NOT commit .env.
# Generate secrets with:  openssl rand -hex 32

# Public hostname Caddy serves + gets HTTPS for, e.g. telemetry.solargators.org
# No domain yet? Use  DOMAIN=:80  to serve plain HTTP on the droplet's IP.
DOMAIN=telemetry.example.org

# Postgres password (used by both db and web).
POSTGRES_PASSWORD=change-me-postgres

# Bearer token the collector must send on upload. Must match the collector's
# FLARE_UPLOAD_TOKEN.  openssl rand -hex 32
FLARE_INGEST_TOKEN=change-me-ingest-token

# Shared team password for viewing the dashboard.
FLARE_VIEW_PASSWORD=change-me-team-password

# Secret key for signing session cookies.  openssl rand -hex 32
SECRET_KEY=change-me-secret-key
